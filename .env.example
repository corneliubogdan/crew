# Copy to .env and chmod 600. Never commit .env.
# Production: long random JWT_SECRET + POSTGRES_PASSWORD. No CORS wildcard.

NODE_ENV=development
PORT=3000

# Postgres (compose interpolates this into DATABASE_URL)
POSTGRES_PASSWORD=changeme-pg

# API
DATABASE_URL=postgres://crew:changeme-pg@postgres:5432/crew
JWT_SECRET=changeme-to-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
SITE_URL=http://localhost:3000
MAGIC_LINK_TTL_MINUTES=15

# Caddy
# Local HTTP: http://:80
# Hetzner HTTPS: your domain, e.g. api.crew.example.com
SITE_ADDRESS=:80
ACME_EMAIL=you@example.com
